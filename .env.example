# 이 파일을 .env로 복사해서 채운다. .env는 커밋하지 않는다(.gitignore).

# LLM (OpenAI 호환). 키가 없으면 LLM 단계가 error: llm_no_key 로 떨어지고 응답 구조는 유지된다.
OPENAI_API_KEY=
# OpenAI 호환 다른 엔드포인트를 쓸 때만. 비우면 OpenAI 기본.
OPENAI_BASE_URL=
# 모델 이름
MODEL_NAME=gpt-4o-mini

# CORS 허용 출처. 쉼표로 여러 개. '*'는 무시된다. 배포 후 Vercel 도메인을 추가한다.
FRONTEND_ORIGINS=http://localhost:5173

# SQLite 파일 경로. 디렉터리가 없으면 만든다. (Render 무료 플랜은 디스크가 재배포 때 초기화됨)
DB_PATH=./data/app.db

# (호환용 옛 이름: LLM_API_KEY, LLM_BASE_URL, LLM_MODEL, FE_ORIGIN 도 그대로 읽힌다)
